{
  "name": "songlist-system",
  "version": "1.0.0",
  "description": "主播歌单管理系统",
  "main": "backend/app.js",
  "scripts": {
    "start": "node start.js",
    "start-direct": "node backend/app.js",
    "dev": "nodemon backend/app.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "serve": "PORT=8080 node backend/app.js",
    "serve-windows": "set PORT=8080 && node backend/app.js",
    "init-db": "node scripts/init-db.js",
    "verify": "node scripts/verify-fix.js",
    "build": "vite build --config frontend/vite.config.js",
    "clean": "rm -rf backend/data/database.sqlite frontend/uploads/*"
  },
  "keywords": [
    "songlist",
    "streamer",
    "vue",
    "express"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
