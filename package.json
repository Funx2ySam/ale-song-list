    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.10",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "naive-ui": "^2.44.1",
    "path": "^0.12.7",
    "validator": "^13.15.15",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
